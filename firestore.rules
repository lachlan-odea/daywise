rules_version = '2';

// daywise Firestore security rules.
// Each user can only read and write their own document tree under /users/{uid},
// including all subcollections (timetable, entries, programs, planning, meta, state).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Admin identity
    // ---------------------------------------------------------------------
    // Admins may READ any user's data (for the admin usage dashboard); users still
    // only ever write their own tree.
    //
    // SECURITY: admin is keyed on UID, deliberately NOT on the email claim.
    //
    // An email allow-list was exploitable: the addresses ship in the public JS
    // bundle, signup is open, and Firebase populates token.email for password
    // accounts whether or not the address is verified — so a stranger could register
    // an allow-listed address and inherit read access to every user's data. It also
    // meant trusting an OIDC `email` claim, which a Microsoft tenant admin can set.
    //
    // A UID is assigned by Firebase, is unguessable, and cannot be claimed by
    // registering any address, so none of the above applies and no email
    // verification is needed to make it safe.
    //
    // These correspond to the two accounts in ADMIN_EMAILS (src/lib/admin.ts).
    // Re-run `node scripts/admin-accounts.mjs` to re-print them if they change.
    // NOTE: a UID is per-account. Deleting and recreating an admin account issues a
    // NEW UID, which must be updated here and in src/lib/admin.ts or admin access
    // will be lost.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in [
          'kaOBMwgr7CTVyJSH3YAdfycWctW2',
          '1k4WK8VOojgUpH9IFNAG9CGAWoj2'
        ];
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Keys the client must never be able to change on its own profile document.
    // `plan` gates paid entitlements (src/lib/entitlements.ts) and is read straight
    // back by the client, so a self-write would be a free upgrade.
    function touches(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // `email` is consumed by the privileged weekly mailer (scripts/send-weekly-reminders.mjs),
    // which runs with a service account and bypasses these rules. Pinning it to the
    // verified auth token stops a user pointing daywise's verified sending domain at
    // a third party.
    function emailPinnedToToken() {
      return !touches(['email'])
        || request.resource.data.email == request.auth.token.email;
    }

    // A loose sanity bound only. The real defence against display-name payloads is
    // in the mailer, which charset-clamps the name before putting it in an email.
    // null is explicitly allowed: a password signup with no name given has a null
    // displayName, and rejecting it here would break login for those accounts.
    function displayNameSane() {
      return !touches(['displayName'])
        || request.resource.data.displayName == null
        || (request.resource.data.displayName is string
            && request.resource.data.displayName.size() <= 200);
    }

    // ---------------------------------------------------------------------
    // Profile document — /users/{userId}
    // ---------------------------------------------------------------------
    // NOTE: this is deliberately a SEPARATE match from the subcollection rule below.
    // Firestore unions (ORs) all matching rules, so a broad recursive wildcard that
    // also covered this document would defeat the field-level validation here.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.email == request.auth.token.email
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'starter');

      allow update: if isOwner(userId)
        && !touches(['plan', 'createdAt'])
        && emailPinnedToToken()
        && displayNameSane();

      allow delete: if isOwner(userId);
    }

    // ---------------------------------------------------------------------
    // Everything beneath the profile — entries, programs, timetable, planning,
    // meta, state, notifications, feedback (and any future subcollection).
    // ---------------------------------------------------------------------
    // The recursive wildcard starts at the subcollection segment so it can never
    // match /users/{userId} itself.
    match /users/{userId}/{collection}/{document=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // Admins may write this one doc in any user's tree (to grant achievement badges).
    // Everything else stays owner-only, keeping "view as" read-only.
    match /users/{userId}/meta/achievements {
      allow write: if isAdmin();
    }

    // NOTE: there is deliberately no /waitlist collection here. The coming-soon page
    // is static and unauthenticated, and App Check is ENFORCED for Cloud Firestore —
    // so requests without an App Check token are rejected before rules are evaluated,
    // regardless of what any rule permits. Rather than load the App Check SDK and
    // reCAPTCHA onto a landing page (or weaken App Check for the whole project), that
    // page posts to a Google Apps Script endpoint instead. See
    // scripts/waitlist-apps-script.gs.

    // ---------------------------------------------------------------------
    // Shared classes — /sharedClasses/{classId}
    // ---------------------------------------------------------------------
    // A class a teacher has shared for collaboration. The owner creates the doc
    // with themselves as the sole member; other teachers join via an invite
    // addressed to their signed-in email (/classInvites below). Phase 1 is
    // read-only collaboration: members read everything, only the owner writes.
    // Membership is tracked twice on the doc — `memberUids` (a list, for
    // array-contains queries) and `members` (a map of uid → {role, name}) — and
    // the rules force the two to move together.
    match /sharedClasses/{classId} {
      function isMember() {
        return request.auth != null && request.auth.uid in resource.data.memberUids;
      }
      function isClassOwner() {
        return request.auth != null && request.auth.uid == resource.data.ownerUid;
      }
      function memberFieldsOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberUids', 'members']);
      }
      // The writer adds exactly one membership entry: their own.
      function addsOnlySelf() {
        return !(request.auth.uid in resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.toSet()
               .difference(resource.data.memberUids.toSet()).hasOnly([request.auth.uid])
          && resource.data.memberUids.toSet()
               .difference(request.resource.data.memberUids.toSet()).size() == 0
          && request.resource.data.members.diff(resource.data.members)
               .affectedKeys().hasOnly([request.auth.uid]);
      }
      // The writer removes exactly one membership entry: their own (leaving).
      function removesOnlySelf() {
        return request.auth.uid in resource.data.memberUids
          && request.auth.uid != resource.data.ownerUid
          && !(request.auth.uid in request.resource.data.memberUids)
          && resource.data.memberUids.toSet()
               .difference(request.resource.data.memberUids.toSet()).hasOnly([request.auth.uid])
          && request.resource.data.memberUids.toSet()
               .difference(resource.data.memberUids.toSet()).size() == 0
          && request.resource.data.members.diff(resource.data.members)
               .affectedKeys().hasOnly([request.auth.uid]);
      }
      // A pending invite addressed to the caller's VERIFIED sign-in email.
      // email_verified is required: Firebase populates token.email for password
      // accounts whether or not the address is verified (see the admin comment
      // above), so without it a stranger could register the invited address and
      // claim the invite. Google sign-in is always verified; password accounts
      // must verify first.
      function hasPendingInvite() {
        return request.auth.token.email != null
          && request.auth.token.email_verified == true
          && get(/databases/$(database)/documents/classInvites/$(classId + '__' + request.auth.token.email.lower())).data.status == 'pending';
      }

      allow read: if isMember() || isAdmin();

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid]);

      // Owner: may edit anything except transferring ownership or dropping
      // themselves from the member list.
      allow update: if isClassOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.auth.uid in request.resource.data.memberUids;

      // Invited teacher: may add exactly themselves while their invite is pending.
      allow update: if request.auth != null && memberFieldsOnly() && addsOnlySelf() && hasPendingInvite();

      // Member: may remove exactly themselves (leave the class).
      allow update: if request.auth != null && memberFieldsOnly() && removesOnlySelf();

      allow delete: if isClassOwner();

      // Program snapshots shared with the class (program docs + their lessons).
      // Guarded via the parent class doc. Writes check both the pre- and
      // post-write parent because the client batches: sharing creates the class
      // doc and its programs atomically (parent only exists AFTER the batch),
      // and unsharing deletes them atomically (parent only exists BEFORE it).
      match /programs/{document=**} {
        allow read: if (request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/sharedClasses/$(classId)).data.memberUids)
          || isAdmin();
        allow write: if request.auth != null && (
          (exists(/databases/$(database)/documents/sharedClasses/$(classId))
            && get(/databases/$(database)/documents/sharedClasses/$(classId)).data.ownerUid == request.auth.uid)
          || (existsAfter(/databases/$(database)/documents/sharedClasses/$(classId))
            && getAfter(/databases/$(database)/documents/sharedClasses/$(classId)).data.ownerUid == request.auth.uid)
        );
      }
    }

    // ---------------------------------------------------------------------
    // Class invites — /classInvites/{inviteId}, id = "<classId>__<email>"
    // ---------------------------------------------------------------------
    // The deterministic id lets the sharedClasses accept rule locate the invite
    // with a get() built from the caller's own token email. An invite grants
    // access to whoever signs in with a VERIFIED matching email — the owner is
    // trusting that address. No update rule: an invite is created pending and
    // then only ever deleted (revoked, declined, or consumed on accept).
    match /classInvites/{inviteId} {
      function addressedToCaller() {
        return request.auth.token.email != null
          && request.auth.token.email_verified == true
          && resource.data.email == request.auth.token.email.lower();
      }

      // Readable by the sender (manage/revoke) and the addressee (accept).
      // Non-admin list queries must filter on ownerUid or email accordingly.
      allow read: if request.auth != null
        && (addressedToCaller() || resource.data.ownerUid == request.auth.uid || isAdmin());

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/sharedClasses/$(request.resource.data.classId)).data.ownerUid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email == request.resource.data.email.lower()
        && inviteId == request.resource.data.classId + '__' + request.resource.data.email
        && request.resource.data.status == 'pending';

      allow delete: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || addressedToCaller());
    }

    // ---------------------------------------------------------------------
    // Broadcast announcements
    // ---------------------------------------------------------------------
    // Signed-in users may only read PUBLISHED announcements; admins see drafts and
    // retracted ones too. Clients reading as a non-admin must constrain the query
    // with where('active','==',true) — see subscribeActiveAnnouncements() in
    // src/lib/announcements.ts — otherwise Firestore rejects the list.
    match /announcements/{id} {
      allow read: if request.auth != null && (resource.data.active == true || isAdmin());
      allow write: if isAdmin();
    }
  }
}
